<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Window Manager.exe: a release's tray app. UI Access lets it drive windows
     of apps running as administrator without being elevated itself. Windows
     grants it only to a signed executable in a folder that needs an
     administrator to change, such as Program Files, and starts it only
     through the shell, never through CreateProcess. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!-- Common Controls 6, as tauri-build's own manifest asks for: the file
       picker behind Choose configuration… needs it. -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="true"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
